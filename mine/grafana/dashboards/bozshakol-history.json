    {
      "id": 7,
      "type": "state-timeline",
      "title": "Сценарии «что если»",
      "description": "Когда какой сценарий шёл: по состоянию двойников сценариев.",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "refId": "A",
          "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and strings.hasPrefix(v: r.thingId, prefix: \"${ns}:scenario-\") and r._field == \"value_status_properties_value\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, name: if r.thingId == \"${ns}:scenario-road-closure\" then \"Закрытие дороги\" else if r.thingId == \"${ns}:scenario-shovel-failure\" then \"Отказ экскаватора\" else if r.thingId == \"${ns}:scenario-crusher-stop\" then \"Остановка дробилки\" else if r.thingId == \"${ns}:scenario-heavy-rain\" then \"Сильный дождь с мокрым снегом\" else if r.thingId == \"${ns}:scenario-blast\" then \"Взрыв блока\" else if r.thingId == \"${ns}:scenario-clay-face\" then \"Глинистая руда в забое\" else if r.thingId == \"${ns}:scenario-clay-plant-stop\" then \"Остановка ОФ-2\" else strings.trimPrefix(v: r.thingId, prefix: \"${ns}:\")}))\n  |> group(columns: [\"name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, name: r.name}))\n  |> group(columns: [\"name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.name}",
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          },
          "custom": {
