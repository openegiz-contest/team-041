      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "refId": "A",
          "query": "every = if int(v: v.windowPeriod) > 60000000000 then v.windowPeriod else 1m\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.thingId == \"${ns}:mill\" and r._field == \"value_feed_tph_properties_value\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> aggregateWindow(every: every, fn: mean, createEmpty: false)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "refId": "B",
          "query": "every = if int(v: v.windowPeriod) > 60000000000 then v.windowPeriod else 1m\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.thingId == \"${ns}:crusher\" and r._field == \"value_throughput_tph_properties_value\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> aggregateWindow(every: every, fn: mean, createEmpty: false)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "refId": "C",
          "query": "every = if int(v: v.windowPeriod) > 60000000000 then v.windowPeriod else 1m\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.thingId == \"${ns}:conveyor\" and r._field == \"value_load_tph_properties_value\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> aggregateWindow(every: every, fn: mean, createEmpty: false)"
        }
